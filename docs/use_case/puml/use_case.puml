@startuml
left to right direction
skinparam linetype polyline
skinparam nodesep 20
skinparam ranksep 80
skinparam usecase {
  BackgroundColor #7FD1F5
}

actor Customer
actor "Bank\nAdministrator" as Admin
actor Scheduler

rectangle "Banking System" {
  usecase "Log in" as UC_Login

  usecase "Open account" as UC_OpenAccount
  usecase "Close account" as UC_CloseAccount
  usecase "Check account balance" as UC_AccountBalance
  usecase "Check transaction\nhistory" as UC_History
  usecase "Deposit money" as UC_Deposit
  usecase "Withdraw money" as UC_Withdraw
  usecase "Request operation\nreversal" as UC_RequestReversal

  usecase "Order transfer" as UC_Transfer
  usecase "Order one-time\ntransfer" as UC_OneTimeTransfer
  usecase "Order standing\ntransfer" as UC_StandingTransfer
  usecase "Cancel standing\ntransfer" as UC_CancelStandingTransfer
  usecase "Convert currency" as UC_ConversionTransfer
  usecase "Execute scheduled\ntransfers" as UC_ScheduledTransfers
  usecase "Check exchange rate" as UC_GetExchangeRate

  usecase "Reverse operation\nmanually" as UC_ReverseOperation
  usecase "Print transaction\nlist" as UC_PrintHistory
  usecase "Print account\nstatement" as UC_PrintStatement
  usecase "Set exchange rates" as UC_SetRates
}

Customer --- UC_Login
UC_Login --- Admin

Customer -- UC_OpenAccount
Customer -- UC_CloseAccount
Customer -- UC_AccountBalance
Customer -- UC_History
Customer -- UC_Deposit
Customer -- UC_Withdraw
Customer -- UC_RequestReversal
Customer -- UC_Transfer
Customer -- UC_CancelStandingTransfer
Customer -- UC_GetExchangeRate

UC_Transfer <|-- UC_OneTimeTransfer
UC_Transfer <|-- UC_StandingTransfer
UC_Transfer <.. UC_ConversionTransfer : <<extend>>

UC_GetExchangeRate <.. UC_ConversionTransfer : <<include>>


UC_ScheduledTransfers -- Scheduler

UC_ReverseOperation -- Admin
UC_PrintHistory -- Admin
UC_PrintStatement -- Admin
UC_SetRates -- Admin

UC_OneTimeTransfer -[hidden]- UC_ReverseOperation
UC_OneTimeTransfer -[hidden]- UC_PrintHistory
UC_OneTimeTransfer -[hidden]- UC_PrintStatement
UC_OneTimeTransfer -[hidden]- UC_SetRates
UC_OneTimeTransfer -[hidden]-UC_ScheduledTransfers

UC_Login -[hidden] UC_OneTimeTransfer
@enduml
