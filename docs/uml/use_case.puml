@startuml
left to right direction
skinparam linetype polyline
skinparam nodesep 20
skinparam ranksep 80
skinparam usecase {
  BackgroundColor #7FD1F5
}

actor Klient
actor "Administrator\nbanku" as Admin
actor Scheduler
actor "BIK" as BIK <<system zewnętrzny>>

rectangle "System bankowy" {
  usecase "Załóż konto" as UC_ZalozKonto
  usecase "Załóż lokatę" as UC_ZalozLokate
  usecase "Zlikwiduj konto" as UC_ZlikwidujKonto
  usecase "Zlikwiduj lokatę" as UC_ZlikwidujLokate
  usecase "Sprawdź stan konta" as UC_StanKonta
  usecase "Sprawdź historię\ntransakcji" as UC_Historia
  usecase "Wpłać pieniądze" as UC_Wplac
  usecase "Wypłać pieniądze" as UC_Wyplac

  usecase "Zleć przelew" as UC_Przelew
  usecase "Zleć przelew\njednorazowy" as UC_PrzelewJednorazowy
  usecase "Zleć przelew\nstały" as UC_PrzelewStaly
  usecase "Wykonaj zaplanowane\nprzelewy" as UC_Zaplanowane
  usecase "Zapłać za zakupy\nonline" as UC_PlatnoscOnline
  usecase "Zapłać w lokalnej\nwalucie" as UC_PlatnoscLokalna
  usecase "Zapłać z\nprzewalutowaniem" as UC_PlatnoscPrzewalutowanie
  usecase "Pobierz kurs waluty" as UC_PobierzKurs
  usecase "Ustal limity\ntransakcji" as UC_Limity

  usecase "Złóż wniosek o wydanie\nkarty płatniczej" as UC_WniosekKarta
  usecase "Zablokuj kartę" as UC_BlokadaKarty
  usecase "Złóż wniosek o kredyt" as UC_WniosekKredyt
  usecase "Oceń zdolność\nkredytową" as UC_Zdolnosc
  usecase "Spłać kredyt" as UC_SplataKredytu
  usecase "Udziel pełnomocnictwa" as UC_Pelnomocnictwo
  usecase "Odwołaj pełnomocnictwo" as UC_OdwolajPelnomocnictwo

  usecase "Rozpatrz wniosek" as UC_Rozpatrz
  usecase "Rozpatrz wniosek\no kartę" as UC_RozpatrzKarta
  usecase "Rozpatrz wniosek\no kredyt" as UC_RozpatrzKredyt
  usecase "Ustal kursy walut" as UC_Kursy
  usecase "Przeglądaj historię\ntransakcji klienta" as UC_HistoriaKlienta
}

Klient -- UC_ZalozKonto
Klient -- UC_ZalozLokate
Klient -- UC_ZlikwidujKonto
Klient -- UC_ZlikwidujLokate
Klient -- UC_StanKonta
Klient -- UC_Historia
Klient -- UC_Wplac
Klient -- UC_Wyplac
Klient -- UC_Przelew
Klient -- UC_PlatnoscOnline
Klient -- UC_Limity
Klient -- UC_WniosekKarta
Klient -- UC_BlokadaKarty
Klient -- UC_WniosekKredyt
Klient -- UC_SplataKredytu
Klient -- UC_Pelnomocnictwo
Klient -- UC_OdwolajPelnomocnictwo

UC_Przelew <|-- UC_PrzelewJednorazowy
UC_Przelew <|-- UC_PrzelewStaly
UC_PlatnoscOnline <|-- UC_PlatnoscLokalna
UC_PlatnoscOnline <|-- UC_PlatnoscPrzewalutowanie

UC_WniosekKredyt ..> UC_Zdolnosc : <<include>>
UC_PlatnoscPrzewalutowanie ..> UC_PobierzKurs : <<include>>

UC_RozpatrzKarta --|> UC_Rozpatrz
UC_RozpatrzKredyt --|> UC_Rozpatrz

UC_PrzelewStaly <.. UC_Zaplanowane : realizuje zlecenia

UC_Zaplanowane -- Scheduler
UC_Zdolnosc -- BIK
UC_Rozpatrz -- Admin
UC_Kursy -- Admin
UC_HistoriaKlienta -- Admin

UC_Wyplac -[hidden]- UC_RozpatrzKarta
UC_Wyplac -[hidden]- UC_RozpatrzKredyt
UC_Wyplac -[hidden]- UC_Kursy
UC_Wyplac -[hidden]- UC_HistoriaKlienta
UC_RozpatrzKarta -[hidden]- UC_Kursy
UC_RozpatrzKarta -[hidden]- UC_HistoriaKlienta
UC_PobierzKurs -[hidden]- BIK

@enduml
